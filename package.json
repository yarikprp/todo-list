{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "json-server --watch db.json --port 3001",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0",
    "copy404": "cpy dist/index.html dist --rename=404.html --flat",
    "predeploy": "run-s build copy404",
    "cleanGhPages": "gh-pages-clean",
    "publishGhPages": "gh-pages -d dist",
    "deploy": "run-s cleanGhPages publishGhPages"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cpy-cli": "^7.0.0",
    "gh-pages": "^6.3.0",
    "json-server": "^1.0.0-beta.15",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.89.0",
    "sass": "^1.107.1",
    "vite": "^8.3.5"
  }
}
